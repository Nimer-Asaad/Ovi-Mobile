// Ovi Mobile — Prisma schema
//
// Portability note:
// Every "enum-like" field below is a `String` constrained to a fixed set of
// values rather than a native Prisma `enum`, kept from the SQLite era of
// this project (SQLite has no native enum type). The canonical list of
// allowed values for each lives in `src/lib/constants.ts` and is mirrored as
// TypeScript string-literal union types in `src/types/index.ts`. Now that
// the datasource is PostgreSQL (Phase 29), these could optionally be
// promoted to real `enum` columns as a separate follow-up, without changing
// application code.
//
// Money note:
// All monetary fields are `Int`, storing the smallest currency unit
// (e.g. agorot for ILS) instead of `Decimal`, to avoid floating-point
// rounding issues — unchanged by the PostgreSQL move.
//
// Database note (Phase 29):
// Production/shared development now uses PostgreSQL (Supabase or
// equivalent) — see DATABASE_URL/DIRECT_URL in .env.example and
// DEPLOYMENT.md. `directUrl` is the non-pooled connection Prisma uses for
// `db push`/`migrate`; `url` is the runtime connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Role values: "ADMIN" | "RETAIL_CUSTOMER" | "WHOLESALE_MERCHANT" | "SALES_REPRESENTATIVE"
/// See src/lib/constants.ts -> ROLES
model User {
  id           String    @id @default(cuid())
  role         String
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  /// Set on every successful login (email/password, Google, or registration
  /// auto-login) — see createSession() in src/lib/auth/session.ts.
  lastLoginAt  DateTime?
  /// Debounced "last seen" timestamp, refreshed by getSession() at most once
  /// every LAST_ACTIVE_REFRESH_MS — see src/lib/auth/session.ts.
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchantProfile            Merchant?
  salesRepresentativeProfile SalesRepresentative?

  ordersPlaced                   Order[]                         @relation("OrderCustomer")
  stockMovements                 StockMovement[]                 @relation("StockMovementCreatedBy")
  sessions                       Session[]
  cart                           Cart?
  wishlistItems                  WishlistItem[]
  orderStatusChanges             OrderStatusHistory[]            @relation("OrderStatusChangedBy")
  orderCompensations             OrderInventoryCompensation[]    @relation("OrderCompensationCreatedBy")
  activityEvents                 UserActivityEvent[]
  auditLogsAsAdmin               AdminAuditLog[]                 @relation("AuditLogAdmin")
  auditLogsAsTarget              AdminAuditLog[]                 @relation("AuditLogTarget")
  accountAsCustomer              CustomerAccount?                @relation("AccountCustomer")
  accountPaymentsRecorded        AccountPayment[]                @relation("AccountPaymentCreatedBy")
  accountPaymentCancellations    AccountPaymentCancellation[]    @relation("AccountPaymentCancelledBy")
  accountOpeningBalancesSet      CustomerAccount[]               @relation("AccountOpeningBalanceSetBy")
  completedVariantAllocations    ProductVariantAllocationBatch[] @relation("VariantAllocationCompletedBy")
  repStockTransferBatchesCreated RepStockTransferBatch[]         @relation("RepStockTransferBatchCreatedBy")
  repCustomerOrdersCreated       RepCustomerOrder[]              @relation("RepCustomerOrderCreatedBy")
  manualInventoryBatchesCreated  ManualInventoryBatch[]          @relation("ManualInventoryBatchCreatedBy")

  @@map("users")
}

/// MerchantStatus values: "PENDING" | "APPROVED" | "REJECTED" | "SUSPENDED"
/// Wholesale pricing is only visible once status = "APPROVED".
/// A merchant is either a real login-based wholesale account (userId set —
/// self-registered via /register/merchant, reviewed by an admin) or a
/// login-less trader contact quick-added directly by an admin or a sales rep
/// (userId null, contactPhone/city/address set instead). Both kinds share
/// this one table and the same admin "التجار" list/rep-assignment/account
/// ledger machinery — the distinction is purely whether userId is set, never
/// a separate parallel model. Display code prefers user.name/user.phone when
/// userId is set and falls back to businessName/contactPhone otherwise.
model Merchant {
  id            String               @id @default(cuid())
  userId        String?              @unique
  user          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  /// Owner/contact person's own name — distinct from businessName (the
  /// store/trade name). Purely descriptive, never used for identity
  /// resolution (that's always contactPhone/user.phone). Optional since a
  /// pre-existing merchant may not have this on file yet.
  contactName   String?
  /// Contact phone/city/address for a login-less trader (userId null) — set
  /// by whoever quick-added them (admin form or a rep during a sale). Stay
  /// null for a real login-based merchant, whose contact info lives on User.
  contactPhone  String?
  /// Separate WhatsApp number — deliberately independent from contactPhone
  /// (a merchant may use a different number for WhatsApp than their main
  /// line). Left null rather than defaulted to contactPhone when not
  /// supplied — never silently assumed to be the same number.
  whatsappPhone String?
  city          String?
  address       String?
  /// Free-form admin notes (e.g. "عميل قديم") — display-only, never parsed
  /// or used in any business logic.
  notes         String?
  taxId         String?
  /// Free-form territory label (e.g. city/area name) used to filter which
  /// merchants a sales rep sees under /rep/merchants — not a separate model
  /// since no geography/hierarchy is needed, just a display + filter value.
  region        String?
  /// MerchantStatus values: "PENDING" | "APPROVED" | "REJECTED" | "SUSPENDED"
  /// SUSPENDED doubles as the archival state for a merchant that has real
  /// financial/business history and therefore can never be hard-deleted
  /// (see deleteMerchant in src/app/admin/merchants/actions.ts) — reused
  /// rather than adding a second, competing isActive field, since SUSPENDED
  /// already carries exactly the right existing semantics everywhere else in
  /// the app (wholesale pricing hidden, checkout/manual-order/rep-sale
  /// eligibility all already gate on status === APPROVED).
  status        String               @default("PENDING")
  approvedAt    DateTime?
  assignedRepId String?
  assignedRep   SalesRepresentative? @relation("RepMerchants", fields: [assignedRepId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  orders            Order[]            @relation("OrderMerchant")
  account           CustomerAccount?
  repCustomerOrders RepCustomerOrder[] @relation("RepCustomerOrderMerchant")

  @@map("merchants")
}

model SalesRepresentative {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedMerchants    Merchant[]              @relation("RepMerchants")
  carStockLocation     StockLocation?
  ordersCreated        Order[]                 @relation("OrderCreatedByRep")
  stockRequests        StockRequest[]
  stockReturns         StockReturn[]
  stockTransferBatches RepStockTransferBatch[]
  customerOrders       RepCustomerOrder[]

  @@map("sales_representatives")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

/// Opaque, DB-backed session. The cookie holds only this row's id — nothing
/// meaningful outside the database — so logout/revocation is a plain delete
/// and there is no signing secret to manage.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Activity tracking & admin audit log
// ---------------------------------------------------------------------------

/// UserActivityEventType values:
/// "LOGIN" | "LOGOUT" | "PRODUCT_VIEWED" | "ADDED_TO_CART" |
/// "REMOVED_FROM_CART" | "CHECKOUT_STARTED" | "ORDER_CREATED" |
/// "ORDER_CANCELLED" | "SEARCH_QUERY" | "ADMIN_ACTION"
///
/// Append-only event log, one row per tracked user action. Designed to scale
/// to millions of rows: no relations are ever joined for a list read (the
/// admin user-detail page reads a bounded, ordered slice by userId), ids are
/// cuid (no auto-increment contention), and the two composite indexes below
/// cover the only two access patterns this table needs — "recent events for
/// one user" and "recent events of one type across all users". Rows are
/// never updated, only inserted, and are safe to periodically archive/prune
/// by createdAt without touching any other table.
///
/// Only LOGIN/LOGOUT are currently written (see src/lib/auth/session.ts).
/// The remaining event types are modeled and ready, but intentionally not
/// yet wired into the storefront (cart/checkout/search/product-browsing)
/// flows — see the Users admin feature report for why.
model UserActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  /// Free-form event detail (e.g. { productId, sku } for PRODUCT_VIEWED,
  /// { query } for SEARCH_QUERY). Never contains secrets or tokens.
  metadata  Json?
  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("user_activity_events")
}

/// AdminAuditAction values:
/// "ROLE_CHANGED" | "ACCOUNT_DISABLED" | "ACCOUNT_ENABLED" |
/// "MERCHANT_APPROVED" | "MERCHANT_REJECTED" | "MERCHANT_SUSPENDED" |
/// "MERCHANT_STATUS_RESET"
///
/// Append-only. Every sensitive admin action against a user account is
/// recorded here with the old and new value, independent of
/// UserActivityEvent (which tracks the target user's own behavior, not what
/// an admin did to them).
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String
  adminUser    User     @relation("AuditLogAdmin", fields: [adminUserId], references: [id])
  targetUserId String
  targetUser   User     @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  action       String
  oldValue     Json?
  newValue     Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(cuid())
  name      String
  nameAr    String?
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  products    Product[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("suppliers")
}

/// Global color master list (mirrors Category/Brand) — a color only becomes
/// offerable for a specific product once a ProductColorOption row links the
/// two. Color is a pure descriptive attribute: it never affects which
/// InventoryItem bucket is decremented (that's determined solely by
/// productId + variantId). CartItem/OrderItem/StockRequestItem/
/// StockReturnItem reference Color directly (not ProductColorOption) so
/// historical rows survive a product no longer offering that color.
model Color {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  hexCode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productOptions      ProductColorOption[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  stockRequestItems   StockRequestItem[]
  stockReturnItems    StockReturnItem[]
  deviceColorVariants DeviceColorVariant[]

  @@map("colors")
}

/// Phone manufacturers are intentionally separate from Brand: Brand is the
/// manufacturer of the catalog product, while PhoneBrand describes devices
/// that a case/protector/lens is compatible with.
model PhoneBrand {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String?
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models PhoneModel[]

  @@map("phone_brands")
}

model PhoneModel {
  id           String     @id @default(cuid())
  phoneBrandId String
  phoneBrand   PhoneBrand @relation(fields: [phoneBrandId], references: [id])
  name         String
  nameAr       String?
  slug         String
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  variants            ProductVariant[]
  deviceColorVariants DeviceColorVariant[]

  @@unique([phoneBrandId, slug])
  @@index([phoneBrandId])
  @@map("phone_models")
}

/// Declares which colors a specific product currently offers — separate
/// from InventoryItem (which tracks quantity). A color can be "offered"
/// with zero current stock (sold out) without disappearing as an option.
model ProductColorOption {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String
  color     Color    @relation(fields: [colorId], references: [id])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, colorId])
  @@map("product_color_options")
}

model Product {
  id            String    @id @default(cuid())
  sku           String    @unique
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  /// Smallest currency unit (e.g. agorot). Price shown to retail customers.
  retailPriceCents    Int
  /// Smallest currency unit. Only visible to approved wholesale merchants.
  wholesalePriceCents Int
  /// Smallest currency unit. Internal cost, admin-only.
  costCents           Int?

  isActive                Boolean  @default(true)
  isFeatured              Boolean  @default(false)
  /// NONE | PHONE_COMPATIBILITY. Existing products remain NONE until an
  /// admin explicitly opts them into variant tracking. Independent of
  /// inventoryTrackingMode below — DEVICE_MODEL_COLOR products always keep
  /// variantMode NONE (enforced by a CHECK constraint), since they never use
  /// the ProductVariant/allocation-batch machinery this field gates.
  variantMode             String   @default("NONE")
  /// NOT_REQUIRED | PENDING | READY. PENDING inventory is never offered as
  /// variant stock until its legacy balance has been reviewed manually.
  variantAllocationStatus String   @default("NOT_REQUIRED")
  /// TOTAL_STOCK | DEVICE_MODEL_COLOR. Per-product choice of how its stock
  /// quantity is tracked — orthogonal to variantMode (the older,
  /// phone-model-only variant system). TOTAL_STOCK is a single plain
  /// InventoryItem bucket per location (variantId and deviceColorVariantId
  /// both null) — the default for every product, including ones already
  /// using variantMode PHONE_COMPATIBILITY. DEVICE_MODEL_COLOR splits stock
  /// into independent buckets per DeviceColorVariant (brand+model+color)
  /// combination — see the DeviceColorVariant/InventoryItem doc comments.
  /// Converting between the two is guarded in src/lib/inventory-tracking.ts
  /// to never silently move or drop quantity.
  inventoryTrackingMode   String   @default("TOTAL_STOCK")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  inventoryItems         InventoryItem[]
  stockMovements         StockMovement[]
  orderItems             OrderItem[]
  stockRequestItems      StockRequestItem[]
  stockReturnItems       StockReturnItem[]
  images                 ProductImage[]
  cartItems              CartItem[]
  wishlistItems          WishlistItem[]
  colorOptions           ProductColorOption[]
  variants               ProductVariant[]
  variantAllocationBatch ProductVariantAllocationBatch?
  deviceColorVariants    DeviceColorVariant[]
  repCustomerOrderItems  RepCustomerOrderItem[]

  @@map("products")
}

/// A single product + phone model + color combination used only by products
/// with inventoryTrackingMode = DEVICE_MODEL_COLOR (typically device cases —
/// جفرات — and similar accessories). Deliberately a separate table from
/// ProductVariant: ProductVariant's identity is unique per (productId,
/// phoneModelId) — one row per model, color excluded on purpose (see its doc
/// comment) — so it cannot represent "the same model in two colors", which
/// this mode requires. isActive lets a combination be retired without
/// deleting historical InventoryItem/StockMovement rows that reference it;
/// productId/phoneModelId are immutable once referenced by either (changing
/// either would genuinely make this track a different device), enforced by a
/// trigger — see the 20260814120000 migration. colorId is deliberately NOT
/// part of that lock (relaxed in the 20260825120000 migration): correcting a
/// wrongly-assigned color doesn't move or represent different physical
/// stock, only relabels the same InventoryItem/StockMovement bucket — see
/// updateDeviceColorComboColor in src/lib/inventory-tracking.ts. Trade-off:
/// StockMovement/order history resolves this row's color live, not from a
/// stored snapshot, so a correction also changes how past movements for the
/// same combination display, not just future ones.
model DeviceColorVariant {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  phoneModelId String
  phoneModel   PhoneModel @relation(fields: [phoneModelId], references: [id])
  colorId      String
  color        Color      @relation(fields: [colorId], references: [id])
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  repCustomerOrderItems RepCustomerOrderItem[]

  @@unique([productId, phoneModelId, colorId])
  @@unique([id, productId])
  @@index([productId, isActive])
  @@index([phoneModelId])
  @@index([colorId])
  @@map("device_color_variants")
}

/// A variant's identity is product + phone model only — this is the sole
/// dimension that determines the stock bucket (see InventoryItem). Color is
/// never part of a variant: it lives independently on CartItem/OrderItem/
/// StockRequestItem/StockReturnItem as a pure descriptive attribute the
/// customer picks, unrelated to which variant's stock gets decremented.
model ProductVariant {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  phoneModelId String
  phoneModel   PhoneModel @relation(fields: [phoneModelId], references: [id])
  variantCode  String?    @unique
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventoryItems        InventoryItem[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  stockMovements        StockMovement[]
  stockRequestItems     StockRequestItem[]
  stockReturnItems      StockReturnItem[]
  repCustomerOrderItems RepCustomerOrderItem[]

  @@unique([productId, phoneModelId])
  @@unique([id, productId])
  @@index([productId, isActive])
  @@index([phoneModelId])
  @@map("product_variants")
}

/// Immutable baseline for the one-time manual conversion of legacy product
/// inventory into variant inventory. A completed batch is never reopened.
model ProductVariantAllocationBatch {
  id                     String          @id @default(cuid())
  productId              String          @unique
  product                Product         @relation(fields: [productId], references: [id])
  originalLegacyQuantity Int
  allocatedQuantity      Int             @default(0)
  status                 String          @default("PENDING")
  createdAt              DateTime        @default(now())
  completedAt            DateTime?
  completedById          String?
  completedBy            User?           @relation("VariantAllocationCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  stockMovements         StockMovement[]

  @@index([status])
  @@map("product_variant_allocation_batches")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

/// One cart per user. No price is stored here — display/checkout price is
/// always computed live from Product.retailPriceCents/wholesalePriceCents
/// based on the viewer's role at read time.
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

/// colorId and variantId are independent, non-exclusive attributes of a
/// line: colorId is purely descriptive (what the customer picked, never
/// affects stock); variantId is the only thing that determines the stock
/// bucket for a PHONE_COMPATIBILITY product. deviceColorVariantId is the
/// stock-bucket dimension for a DEVICE_MODEL_COLOR product instead — it is
/// mutually exclusive with variantId (CHECK constraint, see the migration)
/// and colorId is always left null on a deviceColorVariantId line (the
/// combination's color is already encoded in the DeviceColorVariant itself,
/// so a separate descriptive colorId would be redundant). Uniqueness across
/// the null/non-null combinations of these columns is enforced by
/// hand-authored partial unique indexes (not representable in schema.prisma
/// — see the migration), so application code must use plain `where` filters
/// here too, never the compound-key shorthand (same rule as documented in
/// src/lib/inventory-transactions.ts).
model CartItem {
  id                   String              @id @default(cuid())
  cartId               String
  cart                 Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId            String
  product              Product             @relation(fields: [productId], references: [id])
  colorId              String?
  color                Color?              @relation(fields: [colorId], references: [id])
  variantId            String?
  variant              ProductVariant?     @relation(fields: [variantId, productId], references: [id, productId])
  deviceColorVariantId String?
  deviceColorVariant   DeviceColorVariant? @relation(fields: [deviceColorVariantId, productId], references: [id, productId])
  quantity             Int
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

/// One product can have multiple images; at most one is marked `isMain`.
/// `sortOrder` follows the order images were entered in the admin form.
/// mediaType values: "IMAGE" | "VIDEO" — the `isMain` item must always be
/// "IMAGE" (enforced server-side in admin/products/actions.ts) so every
/// call site that reads images[0].url as a static image stays safe.
model ProductImage {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url                String
  mediaType          String   @default("IMAGE")
  altText            String?
  isMain             Boolean  @default(false)
  sortOrder          Int      @default(0)
  /// Cloudinary's public_id for media uploaded through the admin panel
  /// (src/lib/uploads.ts) — needed to delete the asset later. Null for
  /// admin-pasted external URLs (never uploaded anywhere by us) and for
  /// legacy rows saved before this app used Cloudinary.
  cloudinaryPublicId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// StockLocationType values: "WAREHOUSE" | "REP_CAR"
/// A REP_CAR location always belongs to exactly one SalesRepresentative.
model StockLocation {
  id         String               @id @default(cuid())
  type       String
  name       String
  isDefault  Boolean              @default(false)
  salesRepId String?              @unique
  salesRep   SalesRepresentative? @relation(fields: [salesRepId], references: [id])
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  inventoryItems      InventoryItem[]
  movementsFrom       StockMovement[]              @relation("MovementFromLocation")
  movementsTo         StockMovement[]              @relation("MovementToLocation")
  fulfilledOrders     Order[]
  orderCompensations  OrderInventoryCompensation[]
  transferBatchesFrom RepStockTransferBatch[]      @relation("RepTransferBatchFromLocation")
  transferBatchesTo   RepStockTransferBatch[]      @relation("RepTransferBatchToLocation")

  @@map("stock_locations")
}

/// Current on-hand quantity of a product at a location. Derived data — the
/// source of truth is the StockMovement ledger; this table is a maintained
/// aggregate for fast reads. Deliberately has no plain colorId column: color
/// never determines the stock bucket on its own — color is a pure display
/// attribute on CartItem/OrderItem/etc. (see the Color/CartItem doc
/// comments). The one exception is deviceColorVariantId below, which
/// references a declared *combination* row (product + phone model + color),
/// not a bare color — used only by inventoryTrackingMode = DEVICE_MODEL_COLOR
/// products. variantId and deviceColorVariantId are mutually exclusive
/// (enforced by a CHECK constraint) — a product uses at most one of the two
/// variant systems, matching its Product.variantMode/inventoryTrackingMode.
/// Three uniqueness tiers, each a partial index (see the migration):
/// plain (both null), phone-model variant (variantId set), device+color
/// combination (deviceColorVariantId set).
model InventoryItem {
  id                   String              @id @default(cuid())
  productId            String
  product              Product             @relation(fields: [productId], references: [id])
  locationId           String
  location             StockLocation       @relation(fields: [locationId], references: [id])
  variantId            String?
  variant              ProductVariant?     @relation(fields: [variantId, productId], references: [id, productId])
  deviceColorVariantId String?
  deviceColorVariant   DeviceColorVariant? @relation(fields: [deviceColorVariantId, productId], references: [id, productId])
  quantity             Int                 @default(0)
  updatedAt            DateTime            @updatedAt

  @@unique([productId, locationId, variantId])
  @@map("inventory_items")
}

/// StockMovementType values:
/// "PURCHASE_IN" | "TRANSFER" | "SALE_OUT" | "RETURN_IN" | "ADJUSTMENT" |
/// "REP_ASSIGNMENT" | "REP_RETURN"
///
/// Immutable ledger — every inventory change (purchases, transfers, sales,
/// returns, adjustments, rep stock assignment/return) is recorded here and
/// is never edited or deleted, only appended to.
model StockMovement {
  id                   String                         @id @default(cuid())
  type                 String
  productId            String
  product              Product                        @relation(fields: [productId], references: [id])
  variantId            String?
  variant              ProductVariant?                @relation(fields: [variantId, productId], references: [id, productId])
  deviceColorVariantId String?
  deviceColorVariant   DeviceColorVariant?            @relation(fields: [deviceColorVariantId, productId], references: [id, productId])
  allocationBatchId    String?
  allocationBatch      ProductVariantAllocationBatch? @relation(fields: [allocationBatchId], references: [id])
  /// Groups this row with the other lines created by the same multi-product
  /// admin quick-transfer submission — see RepStockTransferBatch. Null for
  /// every movement type other than REP_ASSIGNMENT/REP_RETURN, and for
  /// REP_ASSIGNMENT/REP_RETURN rows created before this batching existed.
  transferBatchId      String?
  transferBatch        RepStockTransferBatch?         @relation(fields: [transferBatchId], references: [id])
  /// Groups this row with the other lines created by the same manual
  /// STOCK_IN/STOCK_OUT submission (see /admin/inventory/receive, /issue,
  /// and single-line /admin/inventory/adjust) — or marks it as part of a
  /// reversal batch created to cancel one of those. Null for every other
  /// movement type, and for every manual movement created before this
  /// column existed (never backfilled, never auto-grouped by guessing from
  /// createdAt/note/user/adjacent rows — see ManualInventoryBatch's own doc
  /// comment).
  manualBatchId        String?
  manualBatch          ManualInventoryBatch?          @relation(fields: [manualBatchId], references: [id])
  fromLocationId       String?
  fromLocation         StockLocation?                 @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocationId         String?
  toLocation           StockLocation?                 @relation("MovementToLocation", fields: [toLocationId], references: [id])
  quantity             Int
  previousQuantity     Int?
  newQuantity          Int?
  note                 String?
  createdById          String?
  createdBy            User?                          @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime                       @default(now())

  @@index([variantId])
  @@index([deviceColorVariantId])
  @@index([allocationBatchId])
  @@index([transferBatchId])
  @@index([manualBatchId])
  @@map("stock_movements")
}

/// Groups the StockMovement row(s) created by one manual STOCK_IN/STOCK_OUT
/// submission (a single line from /admin/inventory/adjust, or the N lines
/// of one /admin/inventory/receive or /admin/inventory/issue bulk
/// submission) — the batch-level unit a correction cancels or reverses as
/// one atomic operation, exactly the same "group first, reverse the whole
/// group atomically" shape OrderInventoryCompensation already proves out
/// for a sale's inventory effect.
///
/// A REVERSAL batch (reversalOfId set) is a brand-new batch containing
/// brand-new StockMovement rows with the exact opposite effect of the
/// original batch's own rows — the original batch and its StockMovement
/// rows are NEVER edited or deleted (StockMovement stays a strictly
/// append-only ledger). reversalOfId is @unique — the DB-level "a batch may
/// be reversed at most once" guarantee, the same backstop
/// OrderInventoryCompensation's orderId @unique already proves out for
/// orders. correctionReason is required on a reversal batch, always null on
/// an original one.
///
/// A batch predating this table's existence simply has no row here to
/// reference it (StockMovement.manualBatchId stays null on those rows) —
/// never auto-grouped after the fact by guessing.
model ManualInventoryBatch {
  id               String                @id @default(cuid())
  /// ManualStockMovementType values: "STOCK_IN" | "STOCK_OUT" — see
  /// MANUAL_STOCK_MOVEMENT_TYPES in src/lib/constants.ts. The type every
  /// StockMovement row in this batch shares. ADJUSTMENT (absolute-quantity)
  /// batches are out of scope for this table — never created for them.
  movementType     String
  createdById      String
  createdBy        User                  @relation("ManualInventoryBatchCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())
  reversalOfId     String?               @unique
  reversalOf       ManualInventoryBatch? @relation("ManualInventoryBatchReversal", fields: [reversalOfId], references: [id])
  reversedBy       ManualInventoryBatch? @relation("ManualInventoryBatchReversal")
  correctionReason String?

  movements StockMovement[]

  @@map("manual_inventory_batches")
}

/// Groups the per-product StockMovement rows created by one multi-product
/// admin quick-transfer submission (assignStockToRep/returnStockFromRep),
/// purely so the whole car-load can be printed as one combined invoice
/// instead of one per product. type mirrors the STOCK_MOVEMENT_TYPES value
/// ("REP_ASSIGNMENT" | "REP_RETURN") shared by every movement in the batch.
model RepStockTransferBatch {
  id             String              @id @default(cuid())
  type           String
  salesRepId     String
  salesRep       SalesRepresentative @relation(fields: [salesRepId], references: [id], onDelete: Restrict)
  fromLocationId String
  fromLocation   StockLocation       @relation("RepTransferBatchFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String
  toLocation     StockLocation       @relation("RepTransferBatchToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  /// RepLoadType values: "CAR_STOCK" | "CUSTOMER_ORDER" — see
  /// REP_LOAD_TYPES in src/lib/constants.ts and the RepCustomerOrder doc
  /// comment below. Only ever meaningful on a REP_ASSIGNMENT batch; a
  /// REP_RETURN batch always keeps the default CAR_STOCK (returns are never
  /// customer-order-aware — physical inventory is authoritative there).
  loadType       String              @default("CAR_STOCK")
  note           String?
  createdById    String?
  createdBy      User?               @relation("RepStockTransferBatchCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())

  stockMovements StockMovement[]
  customerOrder  RepCustomerOrder?

  @@index([salesRepId])
  @@map("rep_stock_transfer_batches")
}

/// RepCustomerOrderStatus values: "OPEN" | "COMPLETED" | "CANCELLED"
///
/// A logical allocation created alongside a REP_ASSIGNMENT
/// RepStockTransferBatch when the admin picks loadType CUSTOMER_ORDER
/// instead of CAR_STOCK on /admin/reps/[id]/assign-stock (see
/// assignStockToRep). Physical inventory for these items moves through the
/// exact same WAREHOUSE -> REP_CAR path as a normal car load — one shared
/// InventoryItem bucket at the rep's location, never a second reserved
/// quantity. This table only records who the admin intended the stock for
/// and the originally requested items/quantities as a starting template —
/// see RepCustomerOrderItem.
///
/// customerName is free text, the same convention Order.contactName already
/// uses — kept purely for display even now that merchantId exists below,
/// since a legacy row predating this field may still have no merchant link
/// at all.
///
/// merchantId is nullable IN THE SCHEMA only to keep every row created
/// before this field existed valid (see below) — assignStockToRep no longer
/// permits a NEW CUSTOMER_ORDER submission to leave it null. Every new one
/// resolves a real Merchant one of two ways: an existing trader picked by
/// its stable id (used directly, never re-derived from name/phone text), or
/// enough data (customerName + a phone) to resolve/create one via
/// resolveOrCreateRepMerchant in src/lib/rep-merchants.ts — the exact same
/// phone-based rule createRepSale already uses to resolve a sale's trader —
/// so a rep's pending customer-order template and their eventual completed
/// sale share one real trader identity end to end, instead of two
/// disconnected free-text names. Every row created before this rule existed
/// has merchantId = null and is never auto-backfilled by matching
/// customerName text (that would risk merging two different real customers
/// who happened to type the same generic name) — an ADMIN can explicitly
/// link such a row to a real Merchant afterward (see
/// linkRepCustomerOrderMerchant in src/app/admin/reps/actions.ts). Never
/// required for the customer-order lifecycle itself (completion via
/// createRepSale, or cancellation) to function — those work identically
/// whether or not it's set; it exists purely as a display/grouping identity
/// for /admin/reps/[id].
///
/// status starts OPEN and becomes COMPLETED automatically the moment any
/// sale is created from it (see createRepSale), regardless of whether the
/// rep sold the exact original items/quantities — a customer order is a
/// single-use starting template, not a running tab; unsold physical units
/// simply remain in the rep's car as general stock. status becomes
/// CANCELLED only via an explicit admin action (cancelRepCustomerOrder),
/// which never touches physical inventory — stock already loaded stays in
/// the car as general car stock (use the existing Return Stock workflow to
/// send it back to the warehouse).
model RepCustomerOrder {
  id              String                @id @default(cuid())
  salesRepId      String
  salesRep        SalesRepresentative   @relation(fields: [salesRepId], references: [id], onDelete: Restrict)
  customerName    String
  merchantId      String?
  merchant        Merchant?             @relation("RepCustomerOrderMerchant", fields: [merchantId], references: [id], onDelete: SetNull)
  status          String                @default("OPEN")
  transferBatchId String                @unique
  transferBatch   RepStockTransferBatch @relation(fields: [transferBatchId], references: [id], onDelete: Restrict)
  createdById     String?
  createdBy       User?                 @relation("RepCustomerOrderCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  completedAt     DateTime?
  cancelledAt     DateTime?

  items     RepCustomerOrderItem[]
  saleOrder Order?                 @relation("OrderFromCustomerOrder")

  @@index([salesRepId, status])
  @@index([merchantId])
  @@map("rep_customer_orders")
}

/// Snapshot of one intended line at load time. productId/variantId/
/// deviceColorVariantId identify the exact same InventoryItem bucket the
/// transfer moved (see the InventoryItem doc comment); quantity is the
/// originally intended amount — the rep is free to deviate from it when
/// actually selling (see RepCustomerOrder doc comment above), so this row is
/// never updated after creation, only read as the sale form's prefill
/// template. variantId and deviceColorVariantId are mutually exclusive
/// (enforced by a DB CHECK constraint, see the migration — same convention
/// as InventoryItem/StockMovement), matching the InventoryKey shape
/// decrementInventoryAtomic/incrementInventoryUpsert already require.
model RepCustomerOrderItem {
  id                   String              @id @default(cuid())
  repCustomerOrderId   String
  repCustomerOrder     RepCustomerOrder    @relation(fields: [repCustomerOrderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product             @relation(fields: [productId], references: [id])
  variantId            String?
  variant              ProductVariant?     @relation(fields: [variantId, productId], references: [id, productId])
  deviceColorVariantId String?
  deviceColorVariant   DeviceColorVariant? @relation(fields: [deviceColorVariantId, productId], references: [id, productId])
  quantity             Int

  @@index([variantId])
  @@index([deviceColorVariantId])
  @@map("rep_customer_order_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// OrderStatus values:
/// "PENDING" | "CONFIRMED" | "PREPARING" | "OUT_FOR_DELIVERY" | "DELIVERED" |
/// "CANCELLED" | "RETURNED"
///
/// OrderSource values: "RETAIL" | "WHOLESALE" | "REP_SALE" | "ADMIN_MANUAL"
model Order {
  id          String @id @default(cuid())
  orderNumber String @unique
  source      String
  status      String @default("PENDING")

  customerId String?
  customer   User?   @relation("OrderCustomer", fields: [customerId], references: [id])

  merchantId String?
  merchant   Merchant? @relation("OrderMerchant", fields: [merchantId], references: [id])

  createdByRepId String?
  createdByRep   SalesRepresentative? @relation("OrderCreatedByRep", fields: [createdByRepId], references: [id])

  /// Set when this rep sale was started from a customer-order car-load
  /// template (see RepCustomerOrder) — null for a normal blank sale. The
  /// rep may have changed quantities/items freely before selling; this link
  /// only records provenance, never constrains what was actually sold.
  /// @unique is a deliberate DB-level backstop for "one customer order is
  /// consumed by at most one resulting sale" — a plain UNIQUE index still
  /// allows unlimited NULLs (standard Postgres semantics), so every ordinary
  /// blank sale is unaffected; it only ever rejects a second Order somehow
  /// referencing the same already-used RepCustomerOrder. The real
  /// enforcement is still the atomic OPEN -> COMPLETED transition in
  /// createRepSale; this is defense in depth on top of it, not a
  /// replacement.
  repCustomerOrderId String?           @unique
  repCustomerOrder   RepCustomerOrder? @relation("OrderFromCustomerOrder", fields: [repCustomerOrderId], references: [id])

  stockLocationId     String?
  stockLocation       StockLocation? @relation(fields: [stockLocationId], references: [id])
  inventoryRestoredAt DateTime?

  /// Set when this order should count against a merchant/customer/walk-in
  /// debt ledger (src/lib/accounts.ts). Null means an ordinary sale that
  /// isn't tracked — the default for most orders, unchanged from before this
  /// field existed.
  accountId String?
  account   CustomerAccount? @relation(fields: [accountId], references: [id])

  currency      String @default("ILS")
  subtotalCents Int
  discountCents Int    @default(0)
  totalCents    Int

  contactName     String?
  contactPhone    String?
  city            String?
  shippingAddress String?
  notes           String?

  /// PaymentMethod values: "CASH_ON_DELIVERY" | "CASH"
  /// See src/lib/constants.ts -> PAYMENT_METHODS
  paymentMethod   String @default("CASH_ON_DELIVERY")
  /// PaymentStatus values: "PENDING" | "PARTIAL" | "PAID" | "FAILED" | "REFUNDED"
  /// See src/lib/constants.ts -> PAYMENT_STATUSES
  paymentStatus   String @default("PENDING")
  /// Smallest currency unit. Amount actually received from the customer so
  /// far — balance due is always computed as totalCents - paidAmountCents,
  /// never stored, so it can never drift out of sync.
  paidAmountCents Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  inventoryCompensation OrderInventoryCompensation?
  /// Inverse of AccountPayment.sourceOrderId — the "paid now" AccountPayment
  /// recorded at the same moment as this sale, if any (null when
  /// paidAmountCents was 0 at sale time, or for a legacy sale that predates
  /// this relation). Never set/read anywhere except through this real
  /// relation — never inferred from note text.
  initialPayment        AccountPayment?             @relation("OrderInitialPayment")

  @@index([customerId])
  @@index([stockLocationId])
  @@map("orders")
}

model OrderItem {
  id                   String              @id @default(cuid())
  orderId              String
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product             @relation(fields: [productId], references: [id])
  /// Pure descriptive attribute — never affects which InventoryItem bucket
  /// is decremented (see InventoryItem doc comment). colorNameSnapshot below
  /// preserves the display name even if the color is later renamed/removed.
  /// Always null on a deviceColorVariantId line — that combination's color
  /// is already captured in colorNameSnapshot/phoneModelSnapshot/
  /// phoneBrandSnapshot below, reused as-is from the PHONE_COMPATIBILITY
  /// system since the display shape (brand + model + color) is identical.
  colorId              String?
  color                Color?              @relation(fields: [colorId], references: [id])
  variantId            String?
  variant              ProductVariant?     @relation(fields: [variantId, productId], references: [id, productId])
  /// The DEVICE_MODEL_COLOR stock bucket this line decremented from —
  /// mutually exclusive with variantId (CHECK constraint, see the
  /// migration). Snapshots below are populated from this combination's
  /// brand/model/color at order time, same fields the PHONE_COMPATIBILITY
  /// system already uses, so every existing order-display component renders
  /// it with no changes.
  deviceColorVariantId String?
  deviceColorVariant   DeviceColorVariant? @relation(fields: [deviceColorVariantId, productId], references: [id, productId])
  productNameSnapshot  String?
  productSkuSnapshot   String?
  variantCodeSnapshot  String?
  phoneBrandSnapshot   String?
  phoneModelSnapshot   String?
  colorNameSnapshot    String?
  quantity             Int
  unitPriceCents       Int
  totalCents           Int

  @@index([variantId])
  @@index([deviceColorVariantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  reason      String?
  changedById String
  changedBy   User     @relation("OrderStatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_history")
}

model OrderInventoryCompensation {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  type            String
  createdById     String
  createdBy       User          @relation("OrderCompensationCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([stockLocationId])
  @@index([createdById])
  @@map("order_inventory_compensations")
}

// ---------------------------------------------------------------------------
// Accounts (merchant / walk-in debt ledger)
// ---------------------------------------------------------------------------

/// A ledger party for tracking running debt: exactly one of merchantId/
/// customerId is set, or neither (a pure walk-in office customer with no app
/// login) — this invariant is enforced only in application code
/// (getOrCreate* helpers in src/lib/accounts.ts), never constructed
/// elsewhere, the same convention already used for OrderSource/OrderStatus
/// enforcement in src/lib/order-lifecycle.ts. Merchant/customer accounts are
/// created lazily on first need; walk-in accounts are created explicitly by
/// an admin (searchable by phone first, to avoid duplicates).
///
/// Balance due is always computed live — sum of linked non-cancelled/
/// non-returned orders' totalCents minus sum of payments.amountCents — never
/// stored, matching the existing Order.paidAmountCents "never stored"
/// convention.
model CustomerAccount {
  id                    String    @id @default(cuid())
  displayName           String
  phone                 String?
  merchantId            String?   @unique
  merchant              Merchant? @relation(fields: [merchantId], references: [id])
  customerId            String?   @unique
  customer              User?     @relation("AccountCustomer", fields: [customerId], references: [id])
  notes                 String?
  isActive              Boolean   @default(true)
  /// Debt that existed BEFORE this account's first Order under Ovi Mobile —
  /// e.g. a merchant's real pre-existing balance at the time they're
  /// imported/added into the system. Deliberately its OWN explicit term in
  /// the balance formula (see getAccountBalanceCents in src/lib/accounts.ts)
  /// rather than a fabricated Order or AccountPayment — this represents
  /// pre-system history, not a transaction that happened on any particular
  /// day. Always >= 0 (enforced in application code — this system has no
  /// concept of merchant credit/negative debt). Defaults to 0, so every
  /// existing account's computed balance is completely unaffected until an
  /// ADMIN explicitly sets one (see setAccountOpeningBalance in
  /// src/app/admin/accounts/actions.ts — the only place this is ever
  /// written; never settable by a rep, a merchant, or an online merchant's
  /// own self-approval flow).
  openingBalanceCents   Int       @default(0)
  /// Both null until an ADMIN explicitly sets openingBalanceCents away from
  /// its default. Once set, kept for every subsequent correction too (never
  /// cleared back to null) — always reflects "who last touched this value,
  /// and when."
  openingBalanceSetAt   DateTime?
  openingBalanceSetById String?
  openingBalanceSetBy   User?     @relation("AccountOpeningBalanceSetBy", fields: [openingBalanceSetById], references: [id], onDelete: Restrict)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  orders   Order[]
  payments AccountPayment[]

  @@index([phone])
  @@map("customer_accounts")
}

/// AccountPaymentMethod values: "CASH" | "BANK_TRANSFER" | "CHEQUE" | "OTHER"
/// See src/lib/constants.ts -> ACCOUNT_PAYMENT_METHODS
///
/// Append-only ledger entry — never edited or deleted, only inserted. Records
/// money received against an account's overall balance (not necessarily tied
/// to one specific order, since a merchant's payment often settles a running
/// balance rather than one exact invoice).
///
/// Correction model: a wrong payment is NEVER edited/deleted in place — see
/// AccountPaymentCancellation below, a separate immutable record. This row's
/// own amountCents/method/note/receiptNumber/createdAt stay exactly as
/// originally recorded forever, cancelled or not.
model AccountPayment {
  id            String          @id @default(cuid())
  accountId     String
  account       CustomerAccount @relation(fields: [accountId], references: [id])
  amountCents   Int
  method        String
  note          String?
  /// Persisted, human-friendly سند قبض number — "PAY-YYYYMMDD-NNNN", a daily
  /// sequence per Asia/Hebron business day (see generateDailyPaymentReceiptNumber
  /// in src/lib/payment-number.ts), independent of the OVI order-number
  /// sequence. Nullable and NOT backfilled on purpose: every row that existed
  /// before this field shipped keeps receiptNumber = null forever — its
  /// receipt falls back to a deterministic-but-non-sequential display
  /// reference instead (see buildPaymentReceiptReference in
  /// account-labels.ts) — while every NEW row is always assigned one inside
  /// the same transaction that creates it.
  receiptNumber String?         @unique
  createdById   String
  createdBy     User            @relation("AccountPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  /// AccountPaymentOrigin values: "MANUAL" | "SALE_INITIAL" — see
  /// ACCOUNT_PAYMENT_ORIGINS in src/lib/constants.ts. Null only for a
  /// legacy row that predates this column (never backfilled — its true
  /// origin is genuinely unknown and must never be guessed from note
  /// text). MANUAL = a standalone payment recorded directly against an
  /// account (by ADMIN, ADMIN_ASSISTANT, or a rep) — eligible for direct
  /// cancellation. SALE_INITIAL = the "paid now" portion recorded at the
  /// same moment as a sale (see sourceOrderId below) — never eligible for
  /// DIRECT cancellation; correcting it requires correcting the sale
  /// itself (see src/lib/sale-correction.ts), which cancels this payment
  /// as part of that one atomic transaction.
  origin            String?
  /// Set ONLY when origin = SALE_INITIAL — the Order this payment was
  /// recorded for, written at creation time inside the SAME transaction
  /// that created both rows (see createRepSaleCore). The ONE reliable way
  /// to identify a sale-linked payment; never inferred from note text.
  /// @unique because a sale has at most one initial payment.
  sourceOrderId     String?                     @unique
  sourceOrder       Order?                      @relation("OrderInitialPayment", fields: [sourceOrderId], references: [id])
  /// Present only once this payment has been cancelled/reversed. The
  /// original row above is never mutated when this is set — see
  /// AccountPaymentCancellation's own doc comment.
  cancellation      AccountPaymentCancellation?
  /// Set ONLY on a brand-new replacement payment created through the
  /// report-scoped correction flow — points at the ONE original MANUAL
  /// payment this one corrects. @unique enforces "one cancelled payment
  /// gets at most one replacement payment" at the DB level, the same
  /// backstop sourceOrderId/reversalOfId already prove out elsewhere —
  /// never guessed or inferred, always an explicit, server-validated
  /// correction context (see createReplacementPaymentAction in
  /// src/app/admin/reports/actions.ts). NULL for every ordinary
  /// standalone payment (the normal, unconstrained case) and for every
  /// existing row (never backfilled).
  correctsPaymentId String?                     @unique
  correctsPayment   AccountPayment?             @relation("AccountPaymentCorrection", fields: [correctsPaymentId], references: [id])
  /// Inverse of correctsPaymentId — the replacement payment THIS payment
  /// was corrected by, if any.
  correctedBy       AccountPayment?             @relation("AccountPaymentCorrection")

  @@index([accountId, createdAt])
  @@map("account_payments")
}

/// Immutable record of a single AccountPayment's cancellation/reversal —
/// created exactly once per payment (paymentId is @unique, the DB-level
/// "at most one cancellation" guarantee, the same backstop
/// OrderInventoryCompensation's orderId @unique already proves out for
/// orders). Never updated or deleted once created. The cancelled
/// AccountPayment's own amountCents/method/note/receiptNumber/createdAt are
/// NEVER touched — its original chronological position (previous debt /
/// payment / after-payment debt) stays exactly as it was; this row instead
/// represents a SEPARATE, later accounting event (a "+amount back to debt"
/// reversal at cancelledAt) — see buildAccountStatementRows and
/// getAccountBalanceCents in src/lib/accounts.ts /
/// src/lib/account-statement.ts.
model AccountPaymentCancellation {
  id            String         @id @default(cuid())
  paymentId     String         @unique
  payment       AccountPayment @relation(fields: [paymentId], references: [id])
  reason        String
  cancelledById String
  cancelledBy   User           @relation("AccountPaymentCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime       @default(now())

  @@map("account_payment_cancellations")
}

// ---------------------------------------------------------------------------
// Sales representative stock workflow
// ---------------------------------------------------------------------------

/// StockRequestStatus values: "PENDING" | "REVIEWED" | "PREPARED" | "COMPLETED" | "REJECTED"
/// StockRequestType values: "RESTOCK" (RETURN reserved for a future phase)
///
/// Rep-initiated request for stock to be loaded into their car. Creating,
/// reviewing, and preparing a request never touches InventoryItem/
/// StockMovement — only completeStockRequest() does, exactly once, using
/// each line's approvedQuantity (never requestedQuantity).
model StockRequest {
  id            String              @id @default(cuid())
  /// Friendly business number shown to reps/admin — see generateRequestNumber().
  requestNumber String?             @unique
  salesRepId    String
  salesRep      SalesRepresentative @relation(fields: [salesRepId], references: [id])
  status        String              @default("PENDING")
  type          String              @default("RESTOCK")
  repNote       String?
  adminNote     String?
  reviewedAt    DateTime?
  preparedAt    DateTime?
  completedAt   DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items StockRequestItem[]

  @@map("stock_requests")
}

model StockRequestItem {
  id                String          @id @default(cuid())
  stockRequestId    String
  stockRequest      StockRequest    @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  /// Pure descriptive attribute — see InventoryItem doc comment.
  colorId           String?
  color             Color?          @relation(fields: [colorId], references: [id])
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId, productId], references: [id, productId])
  requestedQuantity Int
  /// Set by admin during review. null = not yet reviewed; 0 = rejected/removed line.
  approvedQuantity  Int?

  @@index([variantId])
  @@map("stock_request_items")
}

/// StockReturnStatus values: "PENDING" | "APPROVED" | "REJECTED" | "COMPLETED"
model StockReturn {
  id         String              @id @default(cuid())
  salesRepId String
  salesRep   SalesRepresentative @relation(fields: [salesRepId], references: [id])
  status     String              @default("PENDING")
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  items StockReturnItem[]

  @@map("stock_returns")
}

model StockReturnItem {
  id            String          @id @default(cuid())
  stockReturnId String
  stockReturn   StockReturn     @relation(fields: [stockReturnId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  /// Pure descriptive attribute — see InventoryItem doc comment.
  colorId       String?
  color         Color?          @relation(fields: [colorId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId, productId], references: [id, productId])
  quantity      Int

  @@index([variantId])
  @@map("stock_return_items")
}
