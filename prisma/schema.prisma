// Ovi Mobile — Prisma schema
//
// Portability note:
// Every "enum-like" field below is a `String` constrained to a fixed set of
// values rather than a native Prisma `enum`, kept from the SQLite era of
// this project (SQLite has no native enum type). The canonical list of
// allowed values for each lives in `src/lib/constants.ts` and is mirrored as
// TypeScript string-literal union types in `src/types/index.ts`. Now that
// the datasource is PostgreSQL (Phase 29), these could optionally be
// promoted to real `enum` columns as a separate follow-up, without changing
// application code.
//
// Money note:
// All monetary fields are `Int`, storing the smallest currency unit
// (e.g. agorot for ILS) instead of `Decimal`, to avoid floating-point
// rounding issues — unchanged by the PostgreSQL move.
//
// Database note (Phase 29):
// Production/shared development now uses PostgreSQL (Supabase or
// equivalent) — see DATABASE_URL/DIRECT_URL in .env.example and
// DEPLOYMENT.md. `directUrl` is the non-pooled connection Prisma uses for
// `db push`/`migrate`; `url` is the runtime connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Role values: "ADMIN" | "RETAIL_CUSTOMER" | "WHOLESALE_MERCHANT" | "SALES_REPRESENTATIVE"
/// See src/lib/constants.ts -> ROLES
model User {
  id           String    @id @default(cuid())
  role         String
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  /// Set on every successful login (email/password, Google, or registration
  /// auto-login) — see createSession() in src/lib/auth/session.ts.
  lastLoginAt  DateTime?
  /// Debounced "last seen" timestamp, refreshed by getSession() at most once
  /// every LAST_ACTIVE_REFRESH_MS — see src/lib/auth/session.ts.
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchantProfile            Merchant?
  salesRepresentativeProfile SalesRepresentative?

  ordersPlaced                Order[]                         @relation("OrderCustomer")
  stockMovements              StockMovement[]                 @relation("StockMovementCreatedBy")
  sessions                    Session[]
  cart                        Cart?
  wishlistItems               WishlistItem[]
  orderStatusChanges          OrderStatusHistory[]            @relation("OrderStatusChangedBy")
  orderCompensations          OrderInventoryCompensation[]    @relation("OrderCompensationCreatedBy")
  activityEvents              UserActivityEvent[]
  auditLogsAsAdmin            AdminAuditLog[]                 @relation("AuditLogAdmin")
  auditLogsAsTarget           AdminAuditLog[]                 @relation("AuditLogTarget")
  accountAsCustomer           CustomerAccount?                @relation("AccountCustomer")
  accountPaymentsRecorded     AccountPayment[]                @relation("AccountPaymentCreatedBy")
  completedVariantAllocations ProductVariantAllocationBatch[] @relation("VariantAllocationCompletedBy")

  @@map("users")
}

/// MerchantStatus values: "PENDING" | "APPROVED" | "REJECTED" | "SUSPENDED"
/// Wholesale pricing is only visible once status = "APPROVED".
model Merchant {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  taxId         String?
  /// Free-form territory label (e.g. city/area name) used to filter which
  /// merchants a sales rep sees under /rep/merchants — not a separate model
  /// since no geography/hierarchy is needed, just a display + filter value.
  region        String?
  status        String               @default("PENDING")
  approvedAt    DateTime?
  assignedRepId String?
  assignedRep   SalesRepresentative? @relation("RepMerchants", fields: [assignedRepId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  orders  Order[]          @relation("OrderMerchant")
  account CustomerAccount?

  @@map("merchants")
}

model SalesRepresentative {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedMerchants Merchant[]     @relation("RepMerchants")
  carStockLocation  StockLocation?
  ordersCreated     Order[]        @relation("OrderCreatedByRep")
  stockRequests     StockRequest[]
  stockReturns      StockReturn[]

  @@map("sales_representatives")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

/// Opaque, DB-backed session. The cookie holds only this row's id — nothing
/// meaningful outside the database — so logout/revocation is a plain delete
/// and there is no signing secret to manage.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Activity tracking & admin audit log
// ---------------------------------------------------------------------------

/// UserActivityEventType values:
/// "LOGIN" | "LOGOUT" | "PRODUCT_VIEWED" | "ADDED_TO_CART" |
/// "REMOVED_FROM_CART" | "CHECKOUT_STARTED" | "ORDER_CREATED" |
/// "ORDER_CANCELLED" | "SEARCH_QUERY" | "ADMIN_ACTION"
///
/// Append-only event log, one row per tracked user action. Designed to scale
/// to millions of rows: no relations are ever joined for a list read (the
/// admin user-detail page reads a bounded, ordered slice by userId), ids are
/// cuid (no auto-increment contention), and the two composite indexes below
/// cover the only two access patterns this table needs — "recent events for
/// one user" and "recent events of one type across all users". Rows are
/// never updated, only inserted, and are safe to periodically archive/prune
/// by createdAt without touching any other table.
///
/// Only LOGIN/LOGOUT are currently written (see src/lib/auth/session.ts).
/// The remaining event types are modeled and ready, but intentionally not
/// yet wired into the storefront (cart/checkout/search/product-browsing)
/// flows — see the Users admin feature report for why.
model UserActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  /// Free-form event detail (e.g. { productId, sku } for PRODUCT_VIEWED,
  /// { query } for SEARCH_QUERY). Never contains secrets or tokens.
  metadata  Json?
  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("user_activity_events")
}

/// AdminAuditAction values:
/// "ROLE_CHANGED" | "ACCOUNT_DISABLED" | "ACCOUNT_ENABLED" |
/// "MERCHANT_APPROVED" | "MERCHANT_REJECTED" | "MERCHANT_SUSPENDED" |
/// "MERCHANT_STATUS_RESET"
///
/// Append-only. Every sensitive admin action against a user account is
/// recorded here with the old and new value, independent of
/// UserActivityEvent (which tracks the target user's own behavior, not what
/// an admin did to them).
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String
  adminUser    User     @relation("AuditLogAdmin", fields: [adminUserId], references: [id])
  targetUserId String
  targetUser   User     @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  action       String
  oldValue     Json?
  newValue     Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(cuid())
  name      String
  nameAr    String?
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  products    Product[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("suppliers")
}

/// Global color master list (mirrors Category/Brand) — a color only becomes
/// offerable for a specific product once a ProductColorOption row links the
/// two. Color is a pure descriptive attribute: it never affects which
/// InventoryItem bucket is decremented (that's determined solely by
/// productId + variantId). CartItem/OrderItem/StockRequestItem/
/// StockReturnItem reference Color directly (not ProductColorOption) so
/// historical rows survive a product no longer offering that color.
model Color {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  hexCode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productOptions      ProductColorOption[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  stockRequestItems   StockRequestItem[]
  stockReturnItems    StockReturnItem[]
  deviceColorVariants DeviceColorVariant[]

  @@map("colors")
}

/// Phone manufacturers are intentionally separate from Brand: Brand is the
/// manufacturer of the catalog product, while PhoneBrand describes devices
/// that a case/protector/lens is compatible with.
model PhoneBrand {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String?
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models PhoneModel[]

  @@map("phone_brands")
}

model PhoneModel {
  id           String     @id @default(cuid())
  phoneBrandId String
  phoneBrand   PhoneBrand @relation(fields: [phoneBrandId], references: [id])
  name         String
  nameAr       String?
  slug         String
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  variants            ProductVariant[]
  deviceColorVariants DeviceColorVariant[]

  @@unique([phoneBrandId, slug])
  @@index([phoneBrandId])
  @@map("phone_models")
}

/// Declares which colors a specific product currently offers — separate
/// from InventoryItem (which tracks quantity). A color can be "offered"
/// with zero current stock (sold out) without disappearing as an option.
model ProductColorOption {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String
  color     Color    @relation(fields: [colorId], references: [id])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, colorId])
  @@map("product_color_options")
}

model Product {
  id            String    @id @default(cuid())
  sku           String    @unique
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  /// Smallest currency unit (e.g. agorot). Price shown to retail customers.
  retailPriceCents    Int
  /// Smallest currency unit. Only visible to approved wholesale merchants.
  wholesalePriceCents Int
  /// Smallest currency unit. Internal cost, admin-only.
  costCents           Int?

  isActive                Boolean  @default(true)
  isFeatured              Boolean  @default(false)
  /// NONE | PHONE_COMPATIBILITY. Existing products remain NONE until an
  /// admin explicitly opts them into variant tracking. Independent of
  /// inventoryTrackingMode below — DEVICE_MODEL_COLOR products always keep
  /// variantMode NONE (enforced by a CHECK constraint), since they never use
  /// the ProductVariant/allocation-batch machinery this field gates.
  variantMode             String   @default("NONE")
  /// NOT_REQUIRED | PENDING | READY. PENDING inventory is never offered as
  /// variant stock until its legacy balance has been reviewed manually.
  variantAllocationStatus String   @default("NOT_REQUIRED")
  /// TOTAL_STOCK | DEVICE_MODEL_COLOR. Per-product choice of how its stock
  /// quantity is tracked — orthogonal to variantMode (the older,
  /// phone-model-only variant system). TOTAL_STOCK is a single plain
  /// InventoryItem bucket per location (variantId and deviceColorVariantId
  /// both null) — the default for every product, including ones already
  /// using variantMode PHONE_COMPATIBILITY. DEVICE_MODEL_COLOR splits stock
  /// into independent buckets per DeviceColorVariant (brand+model+color)
  /// combination — see the DeviceColorVariant/InventoryItem doc comments.
  /// Converting between the two is guarded in src/lib/inventory-tracking.ts
  /// to never silently move or drop quantity.
  inventoryTrackingMode   String   @default("TOTAL_STOCK")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  inventoryItems         InventoryItem[]
  stockMovements         StockMovement[]
  orderItems             OrderItem[]
  stockRequestItems      StockRequestItem[]
  stockReturnItems       StockReturnItem[]
  images                 ProductImage[]
  cartItems              CartItem[]
  wishlistItems          WishlistItem[]
  colorOptions           ProductColorOption[]
  variants               ProductVariant[]
  variantAllocationBatch ProductVariantAllocationBatch?
  deviceColorVariants    DeviceColorVariant[]

  @@map("products")
}

/// A single product + phone model + color combination used only by products
/// with inventoryTrackingMode = DEVICE_MODEL_COLOR (typically device cases —
/// جفرات — and similar accessories). Deliberately a separate table from
/// ProductVariant: ProductVariant's identity is unique per (productId,
/// phoneModelId) — one row per model, color excluded on purpose (see its doc
/// comment) — so it cannot represent "the same model in two colors", which
/// this mode requires. isActive lets a combination be retired without
/// deleting historical InventoryItem/StockMovement rows that reference it;
/// identity (productId/phoneModelId/colorId) is immutable once referenced by
/// either, enforced by a trigger — see the migration.
model DeviceColorVariant {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  phoneModelId String
  phoneModel   PhoneModel @relation(fields: [phoneModelId], references: [id])
  colorId      String
  color        Color      @relation(fields: [colorId], references: [id])
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventoryItems InventoryItem[]
  stockMovements StockMovement[]

  @@unique([productId, phoneModelId, colorId])
  @@unique([id, productId])
  @@index([productId, isActive])
  @@index([phoneModelId])
  @@index([colorId])
  @@map("device_color_variants")
}

/// A variant's identity is product + phone model only — this is the sole
/// dimension that determines the stock bucket (see InventoryItem). Color is
/// never part of a variant: it lives independently on CartItem/OrderItem/
/// StockRequestItem/StockReturnItem as a pure descriptive attribute the
/// customer picks, unrelated to which variant's stock gets decremented.
model ProductVariant {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  phoneModelId String
  phoneModel   PhoneModel @relation(fields: [phoneModelId], references: [id])
  variantCode  String?    @unique
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventoryItems    InventoryItem[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockMovements    StockMovement[]
  stockRequestItems StockRequestItem[]
  stockReturnItems  StockReturnItem[]

  @@unique([productId, phoneModelId])
  @@unique([id, productId])
  @@index([productId, isActive])
  @@index([phoneModelId])
  @@map("product_variants")
}

/// Immutable baseline for the one-time manual conversion of legacy product
/// inventory into variant inventory. A completed batch is never reopened.
model ProductVariantAllocationBatch {
  id                     String          @id @default(cuid())
  productId              String          @unique
  product                Product         @relation(fields: [productId], references: [id])
  originalLegacyQuantity Int
  allocatedQuantity      Int             @default(0)
  status                 String          @default("PENDING")
  createdAt              DateTime        @default(now())
  completedAt            DateTime?
  completedById          String?
  completedBy            User?           @relation("VariantAllocationCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  stockMovements         StockMovement[]

  @@index([status])
  @@map("product_variant_allocation_batches")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

/// One cart per user. No price is stored here — display/checkout price is
/// always computed live from Product.retailPriceCents/wholesalePriceCents
/// based on the viewer's role at read time.
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

/// colorId and variantId are independent, non-exclusive attributes of a
/// line: colorId is purely descriptive (what the customer picked, never
/// affects stock); variantId is the only thing that determines the stock
/// bucket. A line can carry either, both, or neither. Uniqueness across the
/// four null/non-null combinations of the two columns is enforced by four
/// hand-authored partial unique indexes (not representable in schema.prisma
/// — see the migration), so application code must use plain `where` filters
/// here too, never the compound-key shorthand (same rule as documented in
/// src/lib/inventory-transactions.ts).
model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  colorId   String?
  color     Color?          @relation(fields: [colorId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId])
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

/// One product can have multiple images; at most one is marked `isMain`.
/// `sortOrder` follows the order images were entered in the admin form.
/// mediaType values: "IMAGE" | "VIDEO" — the `isMain` item must always be
/// "IMAGE" (enforced server-side in admin/products/actions.ts) so every
/// call site that reads images[0].url as a static image stays safe.
model ProductImage {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url                String
  mediaType          String   @default("IMAGE")
  altText            String?
  isMain             Boolean  @default(false)
  sortOrder          Int      @default(0)
  /// Cloudinary's public_id for media uploaded through the admin panel
  /// (src/lib/uploads.ts) — needed to delete the asset later. Null for
  /// admin-pasted external URLs (never uploaded anywhere by us) and for
  /// legacy rows saved before this app used Cloudinary.
  cloudinaryPublicId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// StockLocationType values: "WAREHOUSE" | "REP_CAR"
/// A REP_CAR location always belongs to exactly one SalesRepresentative.
model StockLocation {
  id         String               @id @default(cuid())
  type       String
  name       String
  isDefault  Boolean              @default(false)
  salesRepId String?              @unique
  salesRep   SalesRepresentative? @relation(fields: [salesRepId], references: [id])
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  inventoryItems     InventoryItem[]
  movementsFrom      StockMovement[]              @relation("MovementFromLocation")
  movementsTo        StockMovement[]              @relation("MovementToLocation")
  fulfilledOrders    Order[]
  orderCompensations OrderInventoryCompensation[]

  @@map("stock_locations")
}

/// Current on-hand quantity of a product at a location. Derived data — the
/// source of truth is the StockMovement ledger; this table is a maintained
/// aggregate for fast reads. Deliberately has no plain colorId column: color
/// never determines the stock bucket on its own — color is a pure display
/// attribute on CartItem/OrderItem/etc. (see the Color/CartItem doc
/// comments). The one exception is deviceColorVariantId below, which
/// references a declared *combination* row (product + phone model + color),
/// not a bare color — used only by inventoryTrackingMode = DEVICE_MODEL_COLOR
/// products. variantId and deviceColorVariantId are mutually exclusive
/// (enforced by a CHECK constraint) — a product uses at most one of the two
/// variant systems, matching its Product.variantMode/inventoryTrackingMode.
/// Three uniqueness tiers, each a partial index (see the migration):
/// plain (both null), phone-model variant (variantId set), device+color
/// combination (deviceColorVariantId set).
model InventoryItem {
  id                   String              @id @default(cuid())
  productId            String
  product              Product             @relation(fields: [productId], references: [id])
  locationId           String
  location             StockLocation       @relation(fields: [locationId], references: [id])
  variantId            String?
  variant              ProductVariant?     @relation(fields: [variantId, productId], references: [id, productId])
  deviceColorVariantId String?
  deviceColorVariant   DeviceColorVariant? @relation(fields: [deviceColorVariantId, productId], references: [id, productId])
  quantity             Int                 @default(0)
  updatedAt            DateTime            @updatedAt

  @@unique([productId, locationId, variantId])
  @@map("inventory_items")
}

/// StockMovementType values:
/// "PURCHASE_IN" | "TRANSFER" | "SALE_OUT" | "RETURN_IN" | "ADJUSTMENT" |
/// "REP_ASSIGNMENT" | "REP_RETURN"
///
/// Immutable ledger — every inventory change (purchases, transfers, sales,
/// returns, adjustments, rep stock assignment/return) is recorded here and
/// is never edited or deleted, only appended to.
model StockMovement {
  id                   String                         @id @default(cuid())
  type                 String
  productId            String
  product              Product                        @relation(fields: [productId], references: [id])
  variantId            String?
  variant              ProductVariant?                @relation(fields: [variantId, productId], references: [id, productId])
  deviceColorVariantId String?
  deviceColorVariant   DeviceColorVariant?            @relation(fields: [deviceColorVariantId, productId], references: [id, productId])
  allocationBatchId    String?
  allocationBatch      ProductVariantAllocationBatch? @relation(fields: [allocationBatchId], references: [id])
  fromLocationId       String?
  fromLocation         StockLocation?                 @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocationId         String?
  toLocation           StockLocation?                 @relation("MovementToLocation", fields: [toLocationId], references: [id])
  quantity             Int
  previousQuantity     Int?
  newQuantity          Int?
  note                 String?
  createdById          String?
  createdBy            User?                          @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime                       @default(now())

  @@index([variantId])
  @@index([deviceColorVariantId])
  @@index([allocationBatchId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// OrderStatus values:
/// "PENDING" | "CONFIRMED" | "PREPARING" | "OUT_FOR_DELIVERY" | "DELIVERED" |
/// "CANCELLED" | "RETURNED"
///
/// OrderSource values: "RETAIL" | "WHOLESALE" | "REP_SALE" | "ADMIN_MANUAL"
model Order {
  id          String @id @default(cuid())
  orderNumber String @unique
  source      String
  status      String @default("PENDING")

  customerId String?
  customer   User?   @relation("OrderCustomer", fields: [customerId], references: [id])

  merchantId String?
  merchant   Merchant? @relation("OrderMerchant", fields: [merchantId], references: [id])

  createdByRepId String?
  createdByRep   SalesRepresentative? @relation("OrderCreatedByRep", fields: [createdByRepId], references: [id])

  stockLocationId     String?
  stockLocation       StockLocation? @relation(fields: [stockLocationId], references: [id])
  inventoryRestoredAt DateTime?

  /// Set when this order should count against a merchant/customer/walk-in
  /// debt ledger (src/lib/accounts.ts). Null means an ordinary sale that
  /// isn't tracked — the default for most orders, unchanged from before this
  /// field existed.
  accountId String?
  account   CustomerAccount? @relation(fields: [accountId], references: [id])

  currency      String @default("ILS")
  subtotalCents Int
  discountCents Int    @default(0)
  totalCents    Int

  contactName     String?
  contactPhone    String?
  city            String?
  shippingAddress String?
  notes           String?

  /// PaymentMethod values: "CASH_ON_DELIVERY" | "CASH"
  /// See src/lib/constants.ts -> PAYMENT_METHODS
  paymentMethod   String @default("CASH_ON_DELIVERY")
  /// PaymentStatus values: "PENDING" | "PARTIAL" | "PAID" | "FAILED" | "REFUNDED"
  /// See src/lib/constants.ts -> PAYMENT_STATUSES
  paymentStatus   String @default("PENDING")
  /// Smallest currency unit. Amount actually received from the customer so
  /// far — balance due is always computed as totalCents - paidAmountCents,
  /// never stored, so it can never drift out of sync.
  paidAmountCents Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  inventoryCompensation OrderInventoryCompensation?

  @@index([customerId])
  @@index([stockLocationId])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  /// Pure descriptive attribute — never affects which InventoryItem bucket
  /// is decremented (see InventoryItem doc comment). colorNameSnapshot below
  /// preserves the display name even if the color is later renamed/removed.
  colorId             String?
  color               Color?          @relation(fields: [colorId], references: [id])
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId, productId], references: [id, productId])
  productNameSnapshot String?
  productSkuSnapshot  String?
  variantCodeSnapshot String?
  phoneBrandSnapshot  String?
  phoneModelSnapshot  String?
  colorNameSnapshot   String?
  quantity            Int
  unitPriceCents      Int
  totalCents          Int

  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  reason      String?
  changedById String
  changedBy   User     @relation("OrderStatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_history")
}

model OrderInventoryCompensation {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  type            String
  createdById     String
  createdBy       User          @relation("OrderCompensationCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([stockLocationId])
  @@index([createdById])
  @@map("order_inventory_compensations")
}

// ---------------------------------------------------------------------------
// Accounts (merchant / walk-in debt ledger)
// ---------------------------------------------------------------------------

/// A ledger party for tracking running debt: exactly one of merchantId/
/// customerId is set, or neither (a pure walk-in office customer with no app
/// login) — this invariant is enforced only in application code
/// (getOrCreate* helpers in src/lib/accounts.ts), never constructed
/// elsewhere, the same convention already used for OrderSource/OrderStatus
/// enforcement in src/lib/order-lifecycle.ts. Merchant/customer accounts are
/// created lazily on first need; walk-in accounts are created explicitly by
/// an admin (searchable by phone first, to avoid duplicates).
///
/// Balance due is always computed live — sum of linked non-cancelled/
/// non-returned orders' totalCents minus sum of payments.amountCents — never
/// stored, matching the existing Order.paidAmountCents "never stored"
/// convention.
model CustomerAccount {
  id          String    @id @default(cuid())
  displayName String
  phone       String?
  merchantId  String?   @unique
  merchant    Merchant? @relation(fields: [merchantId], references: [id])
  customerId  String?   @unique
  customer    User?     @relation("AccountCustomer", fields: [customerId], references: [id])
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders   Order[]
  payments AccountPayment[]

  @@index([phone])
  @@map("customer_accounts")
}

/// AccountPaymentMethod values: "CASH" | "BANK_TRANSFER" | "CHEQUE" | "OTHER"
/// See src/lib/constants.ts -> ACCOUNT_PAYMENT_METHODS
///
/// Append-only ledger entry — never edited or deleted, only inserted. Records
/// money received against an account's overall balance (not necessarily tied
/// to one specific order, since a merchant's payment often settles a running
/// balance rather than one exact invoice).
model AccountPayment {
  id          String          @id @default(cuid())
  accountId   String
  account     CustomerAccount @relation(fields: [accountId], references: [id])
  amountCents Int
  method      String
  note        String?
  createdById String
  createdBy   User            @relation("AccountPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([accountId, createdAt])
  @@map("account_payments")
}

// ---------------------------------------------------------------------------
// Sales representative stock workflow
// ---------------------------------------------------------------------------

/// StockRequestStatus values: "PENDING" | "REVIEWED" | "PREPARED" | "COMPLETED" | "REJECTED"
/// StockRequestType values: "RESTOCK" (RETURN reserved for a future phase)
///
/// Rep-initiated request for stock to be loaded into their car. Creating,
/// reviewing, and preparing a request never touches InventoryItem/
/// StockMovement — only completeStockRequest() does, exactly once, using
/// each line's approvedQuantity (never requestedQuantity).
model StockRequest {
  id            String              @id @default(cuid())
  /// Friendly business number shown to reps/admin — see generateRequestNumber().
  requestNumber String?             @unique
  salesRepId    String
  salesRep      SalesRepresentative @relation(fields: [salesRepId], references: [id])
  status        String              @default("PENDING")
  type          String              @default("RESTOCK")
  repNote       String?
  adminNote     String?
  reviewedAt    DateTime?
  preparedAt    DateTime?
  completedAt   DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items StockRequestItem[]

  @@map("stock_requests")
}

model StockRequestItem {
  id                String          @id @default(cuid())
  stockRequestId    String
  stockRequest      StockRequest    @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  /// Pure descriptive attribute — see InventoryItem doc comment.
  colorId           String?
  color             Color?          @relation(fields: [colorId], references: [id])
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId, productId], references: [id, productId])
  requestedQuantity Int
  /// Set by admin during review. null = not yet reviewed; 0 = rejected/removed line.
  approvedQuantity  Int?

  @@index([variantId])
  @@map("stock_request_items")
}

/// StockReturnStatus values: "PENDING" | "APPROVED" | "REJECTED" | "COMPLETED"
model StockReturn {
  id         String              @id @default(cuid())
  salesRepId String
  salesRep   SalesRepresentative @relation(fields: [salesRepId], references: [id])
  status     String              @default("PENDING")
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  items StockReturnItem[]

  @@map("stock_returns")
}

model StockReturnItem {
  id            String          @id @default(cuid())
  stockReturnId String
  stockReturn   StockReturn     @relation(fields: [stockReturnId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  /// Pure descriptive attribute — see InventoryItem doc comment.
  colorId       String?
  color         Color?          @relation(fields: [colorId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId, productId], references: [id, productId])
  quantity      Int

  @@index([variantId])
  @@map("stock_return_items")
}
